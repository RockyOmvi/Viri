# Viri Testnet — Azure Terraform Variables
#
# 1. Install Azure CLI: https://aka.ms/installazurecliwindows
# 2. Login: az login
# 3. Copy this file to terraform.tfvars and fill in your values
# 4. Run: terraform init && terraform plan && terraform apply
#
# Cost estimate (7 x Standard_B2s = ~$210/month, $100 credit lasts ~14 days)
# To save cost: set vm_sku = "Standard_B1ms" (~$91/month, 100 credit lasts ~33 days)

# Azure region — pick the closest to you
#   eastus, eastus2, westeurope, southeastasia, japaneast, etc.
location = "eastus"

# SSH public key content (required)
# Generate: ssh-keygen -t ed25519 -f ~/.ssh/viri-azure -C "viri-testnet"
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZ..."

# Admin username for VM access (default: viriadmin)
# admin_username = "viriadmin"

# VM size — B2s (2vCPU/4GB) for performance, B1ms (1vCPU/2GB) for cost savings
# vm_sku = "Standard_B2s"

# Optional: domain for TLS certificates (leave empty if not using TLS)
# domain = "testnet.viri.io"

# Optional: faucet wallet private key (hex-encoded, required for faucet node)
# Generate: openssl rand -hex 32
# faucet_wallet_key = "abc123..."
