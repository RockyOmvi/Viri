version: "3.8"

services:
  virid:
    image: ghcr.io/viri-chain/viri:latest
    container_name: virid-faucet
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ viri_data_dir }}:/data
      - {{ viri_home }}/config:/config
      - {{ viri_home }}/logs:/logs
    environment:
      - VIRI_CHAIN_ID={{ chain_id }}
      - VIRI_NETWORK_NAME={{ network_name }}
      - VIRI_LISTEN_ADDR=0.0.0.0:{{ p2p_port }}
      - VIRI_DATA_DIR=/data
      - VIRI_LOG_DIR=/logs
      - VIRI_LOG_LEVEL=info
      - VIRI_BOOTSTRAP_PEERS={{ bootstrap_multiaddr }}
      - VIRI_BLOCK_TIME={{ block_time }}
      - VIRI_TLS_CERT=/config/tls/cert.pem
      - VIRI_TLS_KEY=/config/tls/key.pem
    command: >
      --faucet --faucet-port {{ faucet_port }}
      --explorer --explorer-port {{ explorer_port }}
      --rpc --rpc-port {{ rpc_port }}
      --api --api-port {{ api_port }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ explorer_port }}/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
