# Viri Blockchain APT Repository
# See: https://viri-chain.org/docs/installation/apt
#
# Usage: curl -fsSL https://viri-chain.org/apt/setup.sh | sudo bash
#
# Manual setup:
#   sudo mkdir -p /usr/share/keyrings
#   curl -fsSL https://viri-chain.org/apt/viri.gpg.key | sudo gpg --dearmor -o /usr/share/keyrings/viri-archive-keyring.gpg
#   echo "deb [signed-by=/usr/share/keyrings/viri-archive-keyring.gpg] https://viri-chain.org/apt stable main" | sudo tee /etc/apt/sources.list.d/viri.list
#   sudo apt-get update
#   sudo apt-get install virid virictl

deb [signed-by=/usr/share/keyrings/viri-archive-keyring.gpg] https://viri-chain.org/apt stable main
