{
  "_comment": "Viri Blockchain - Mainnet Node Configuration",
  "_docs": "See DEPLOYMENT.md for installation and configuration guide",

  "chain": {
    "chain_id": 1,
    "network_name": "viri-mainnet",
    "block_time": "1s",
    "max_block_size": 10485760,
    "max_gas_per_block": 30000000,
    "genesis_file": "configs/genesis/mainnet.json"
  },

  "network": {
    "listen_addr": "0.0.0.0:30303",
    "external_addr": "",
    "bootstrap_peers": [
      "/ip4/BOOTSTRAP_NODE_IP/tcp/30303/p2p/BOOTSTRAP_PEER_ID"
    ],
    "bootstrap_peers_comment": "Replace BOOTSTRAP_NODE_IP with the bootstrap node's public IP and BOOTSTRAP_PEER_ID with the bootstrap node's peer ID. Get the peer ID: ssh to the bootstrap VM and run: virictl id. See deploy/one-command-provision.sh."
    "max_peers": 100,
    "enable_dht": true,
    "enable_nat": true
  },

  "node": {
    "name": "viri-mainnet-node",
    "data_dir": "/var/lib/virid",
    "validator_mode": false,
    "validator_key": "",
    "rpc_enabled": true,
    "rpc_port": 8545,
    "api_enabled": true,
    "api_port": 8546,
    "tls_cert_path": "/etc/virid/tls/server.crt",
    "tls_key_path": "/etc/virid/tls/server.key",
    "api_key_hash": ""
  },

  "consensus": {
    "min_stake": 10000000,
    "max_validators": 100,
    "epoch_length": 1000,
    "slashing_enabled": true,
    "finality_threshold": "2s"
  },

  "storage": {
    "backend": "leveldb",
    "path": "/var/lib/virid/chaindata",
    "max_state_size": 10737418240,
    "pruning_enabled": true,
    "pruning_keep_recent": 100000,
    "archive_mode": false
  },

  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "max_size": 100,
    "max_backups": 5
  },

  "readiness": {
    "min_peers": 3,
    "min_block_height": 0,
    "force_ready": false
  }
}
